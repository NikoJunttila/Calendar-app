package landing

import (
	"gothstack/app/views/layouts"
)

templ Test(title, description string){
	<div>
	<h1>hello {title}</h1>
	<p>{description}</p>
	</div>

}

templ Index() {
	@layouts.App() {
		<!-- Hero Section -->
		<div class="container mx-auto px-4 md:px-6 py-12 md:py-24">
			<div class="flex flex-col md:flex-row items-center gap-12">
				<!-- Left side: Main Content -->
				<div class="flex-1 space-y-8">
					<div class="space-y-4">
						<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">Track Your Time, <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">Maximize Your Day</span></h1>
						<p class="text-lg md:text-xl max-w-2xl">Simplify time tracking for work and personal activities with an intuitive calendar system designed to boost your productivity.</p>
					</div>
					
					<div class="flex flex-wrap gap-4">
						<a href="/signup" class="bg-primary hover:bg-primary/90 text-primary-foreground font-medium rounded-md px-6 py-3 inline-flex items-center transition-colors">
							Get Started
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
							</svg>
						</a>
						<a href="#features" class="bg-background hover:bg-muted border border-input hover:border-primary rounded-md px-6 py-3 font-medium inline-flex items-center transition-colors">
							Learn More
						</a>
					</div>
				</div>
				
				<!-- Right side: Calendar Preview -->
				<div class="flex-1 w-full max-w-lg">
					<div class="border rounded-lg shadow-sm overflow-hidden">
						<div class="p-4 border-b">
							<div class="flex justify-between items-center">
								<h3 class="font-medium">September 2024</h3>
								<div class="flex gap-2">
									<button class="p-1 rounded hover:bg-muted">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
									</button>
									<button class="p-1 rounded hover:bg-muted">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
										</svg>
									</button>
								</div>
							</div>
						</div>
						
						<div class="grid grid-cols-7 text-center text-sm p-2 border-b">
							<div class="py-1">Su</div>
							<div class="py-1">Mo</div>
							<div class="py-1">Tu</div>
							<div class="py-1">We</div>
							<div class="py-1">Th</div>
							<div class="py-1">Fr</div>
							<div class="py-1">Sa</div>
						</div>
						
						<div class="grid grid-cols-7 gap-1 p-2 text-sm">
							<div class="p-2 text-center text-muted-foreground">25</div>
							<div class="p-2 text-center text-muted-foreground">26</div>
							<div class="p-2 text-center text-muted-foreground">27</div>
							<div class="p-2 text-center text-muted-foreground">28</div>
							<div class="p-2 text-center text-muted-foreground">29</div>
							<div class="p-2 text-center text-muted-foreground">30</div>
							<div class="p-2 text-center rounded">1</div>
							<div class="p-2 text-center rounded">2</div>
							<div class="p-2 text-center rounded">3</div>
							<div class="p-2 text-center rounded">4</div>
							<div class="p-2 text-center rounded">5</div>
							<div class="p-2 text-center rounded">6</div>
							<div class="p-2 text-center rounded">7</div>
							<div class="p-2 text-center rounded">8</div>
							<div class="p-2 text-center bg-indigo-100 text-indigo-700 rounded font-medium">9</div>
							<div class="p-2 text-center rounded">10</div>
							<div class="p-2 text-center rounded">11</div>
							<div class="p-2 text-center bg-purple-100 text-purple-700 rounded font-medium">12</div>
							<div class="p-2 text-center rounded">13</div>
							<div class="p-2 text-center rounded">14</div>
							<div class="p-2 text-center rounded">15</div>
							<div class="p-2 text-center bg-pink-100 text-pink-700 rounded font-medium">16</div>
							<div class="p-2 text-center rounded">17</div>
							<div class="p-2 text-center rounded">18</div>
							<div class="p-2 text-center rounded">19</div>
							<div class="p-2 text-center rounded">20</div>
							<div class="p-2 text-center rounded">21</div>
							<div class="p-2 text-center rounded">22</div>
							<div class="p-2 text-center rounded">23</div>
							<div class="p-2 text-center rounded">24</div>
							<div class="p-2 text-center rounded">25</div>
							<div class="p-2 text-center rounded">26</div>
							<div class="p-2 text-center rounded">27</div>
							<div class="p-2 text-center rounded">28</div>
							<div class="p-2 text-center bg-indigo-100 text-indigo-700 rounded font-medium">29</div>
							<div class="p-2 text-center rounded">30</div>
							<div class="p-2 text-center text-muted-foreground">1</div>
							<div class="p-2 text-center text-muted-foreground">2</div>
							<div class="p-2 text-center text-muted-foreground">3</div>
							<div class="p-2 text-center text-muted-foreground">4</div>
							<div class="p-2 text-center text-muted-foreground">5</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		@FeaturesSection()	
		
		<!-- CTA Section -->
		<div class="container mx-auto px-4 md:px-6 py-16 text-black">
			<div class="border rounded-xl p-8 md:p-12 bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-300">
				<div class="max-w-3xl mx-auto text-center space-y-6">
					<h2 class="text-3xl md:text-4xl font-bold">Ready to Take Control of Your Time?</h2>
					<p class="text-lg">Join thousands of users who have improved their productivity with our calendar tracker.</p>
					<div class="flex flex-wrap justify-center gap-4">
						<a href="/signup" class="bg-gray-300 hover:bg-primary/90 text-primary-foreground font-medium rounded-md px-6 py-3 inline-flex items-center transition-colors">
							Start Free Trial
						</a>
						<a href="#" class="bg-gray-800 text-white hover:bg-muted border border-input hover:border-primary rounded-md px-6 py-3 font-medium inline-flex items-center transition-colors">
							Learn More
						</a>
					</div>
				</div>
			</div>
		</div>
	}
}
templ FeaturesSection() {
	<div id="features" class="container mx-auto px-4 md:px-6 py-16 md:py-24">
		<div class="text-center mb-16">
			<h2 class="text-3xl md:text-4xl font-bold mb-4">Features Designed for Your Productivity</h2>
			<p class="text-lg max-w-3xl mx-auto">Our calendar tracker helps you organize work and personal time with powerful features.</p>
		</div>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			<!-- Feature 1 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-indigo-100 text-indigo-600 group-hover:bg-indigo-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Smart Calendar</h3>
				<p>Track work hours, personal activities, and appointments in one intuitive calendar interface.</p>
			</div>
			
			<!-- Feature 2 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-purple-100 text-purple-600 group-hover:bg-purple-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Activity Logging</h3>
				<p>Log and categorize activities to gain insights into how you spend your time.</p>
			</div>
			
			<!-- Feature 3 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-pink-100 text-pink-600 group-hover:bg-pink-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Reading Tracker</h3>
				<p>Keep track of your reading habits, progress, and schedule dedicated reading time.</p>
			</div>
			
			<!-- Feature 4 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-indigo-100 text-indigo-600 group-hover:bg-indigo-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Productivity Reports</h3>
				<p>Generate detailed reports on your productivity patterns and time utilization.</p>
			</div>
			
			<!-- Feature 5 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-purple-100 text-purple-600 group-hover:bg-purple-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Smart Reminders</h3>
				<p>Set customizable reminders for work tasks, personal activities, or reading sessions.</p>
			</div>
			
			<!-- Feature 6 -->
			<div class="feature-card border rounded-lg p-6 space-y-4 transition-all duration-300 hover:shadow-lg hover:border-opacity-80 relative overflow-hidden group">
				<div class="light-effect absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none" style="background: radial-gradient(circle 100px at var(--x, 50%) var(--y, 50%), rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);"></div>
				<div class="w-12 h-12 flex items-center justify-center rounded-full bg-pink-100 text-pink-600 group-hover:bg-pink-200 transition-all duration-300">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
					</svg>
				</div>
				<h3 class="text-xl font-medium">Multi-platform Sync</h3>
				<p>Access your calendar and data seamlessly across all your devices with real-time synchronization.</p>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const cards = document.querySelectorAll('.feature-card');
			
			cards.forEach(card => {
				card.addEventListener('mousemove', function(e) {
					const rect = card.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					
					// Calculate rotation (max 5 degrees)
					const rotateX = (((y / rect.height) * 2) - 1) * -5;
					const rotateY = (((x / rect.width) * 2) - 1) * 5;
					
					// Set transform and light effect
					card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
					
					// Update light position
					const lightEffect = card.querySelector('.light-effect');
					lightEffect.style.setProperty('--x', `${x}px`);
					lightEffect.style.setProperty('--y', `${y}px`);
				});
				
				card.addEventListener('mouseleave', function() {
					// Reset transform on mouse leave
					card.style.transform = 'none';
				});
			});
		});
	</script>
}