package book

import (
	"strconv"
	"path/filepath"

	v "github.com/anthdm/superkit/validate"
	"gothstack/app/views/components"
	"gothstack/app/views/layouts"
)

// BookList renders the list of books
templ BookList(data BookPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<div class="w-full justify-center gap-10">
			<div class="mt-10 lg:mt-20">
				<div class="max-w-4xl mx-auto border rounded-md shadow-sm py-12 px-8 flex flex-col gap-8">
					<h2 class="text-center text-2xl font-medium">My Books</h2>
					<div class="flex justify-end">
						<a href="/books/create" { components.ButtonAttrs()... }>Upload New Book</a>
					</div>
					<div class="mt-6">
						if len(data.Books) == 0 {
							<p class="text-center text-gray-500">No books found. Upload your first book to get started!</p>
						} else {
							<table class="w-full border-collapse">
								<thead>
									<tr class="border-b">
										<th class="text-left py-2 px-4">Name</th>
										<th class="text-left py-2 px-4">Pages</th>
										<th class="text-left py-2 px-4">Uploaded On</th>
										<th class="text-left py-2 px-4">Actions</th>
									</tr>
								</thead>
								<tbody>
									for _, book := range data.Books {
										<tr class="border-b hover:bg-gray-50">
											<td class="py-2 px-4">{ book.Name }</td>
											<td class="py-2 px-4">
												if book.Pages > 0 {
													{ strconv.Itoa(book.Pages) }
												} else {
													<span class="text-gray-400">N/A</span>
												}
											</td>
											<td class="py-2 px-4">{ book.CreatedAt.Format("Jan 02, 2006") }</td>
											<td class="py-2 px-4 flex gap-3">
												<a href={ templ.SafeURL("/books/" + strconv.FormatUint(uint64(book.ID), 10)) } class="text-blue-600 hover:underline">View</a>
												<a href={ templ.SafeURL("/books/" + strconv.FormatUint(uint64(book.ID), 10) + "/read") } class="text-green-600 hover:underline">Read</a>
												<button hx-delete={ "/books/" + strconv.FormatUint(uint64(book.ID), 10) } 
													hx-confirm="Are you sure you want to delete this book?" 
													hx-target="closest tr" 
													hx-swap="outerHTML" 
													class="text-red-600 hover:underline">
													Delete
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// BookCreate renders the book creation form
templ BookCreate(data BookPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<div class="w-full justify-center gap-10">
			<div class="mt-10 lg:mt-20">
				<div class="max-w-md mx-auto border rounded-md shadow-sm py-12 px-8 flex flex-col gap-8">
					<h2 class="text-center text-2xl font-medium">Upload New Book</h2>
					<p class="text-center">Upload a PDF file to add it to your library.</p>
					@BookForm(data.FormValues, data.FormErrors)
				</div>
			</div>
		</div>
	}
}

// BookForm renders the form for creating a book
templ BookForm(values BookFormValues, errors v.Errors) {
	<form hx-post="/books/create" hx-encoding="multipart/form-data" class="flex flex-col gap-4">
		<div class="flex flex-col gap-1">
			<label for="name">Book Title</label>
			<input { components.InputAttrs(errors.Has("name"))... } type="text" name="name" id="name" value={ values.Name }/>
			if errors.Has("name") {
				<div class="text-red-500 text-xs">{ errors.Get("name")[0] }</div>
			}
		</div>

		<div class="flex flex-col gap-1">
			<label for="pages">Number of Pages (optional)</label>
			<input { components.InputAttrs(errors.Has("pages"))... } type="number" name="pages" id="pages" value={ strconv.Itoa(values.Pages) } />
			if errors.Has("pages") {
				<div class="text-red-500 text-xs">{ errors.Get("pages")[0] }</div>
			}
			<p class="text-xs text-gray-500">Leave blank if unknown</p>
		</div>

		<div class="flex flex-col gap-1">
			<label for="pdf_file">PDF File</label>
			<input { components.InputAttrs(errors.Has("pdf_file"))... } type="file" name="pdf_file" id="pdf_file" accept=".pdf" />
			if errors.Has("pdf_file") {
				<div class="text-red-500 text-xs">{ errors.Get("pdf_file")[0] }</div>
			}
			<p class="text-xs text-gray-500">Maximum file size: 50MB</p>
		</div>

		<button { components.ButtonAttrs()... } class="mt-4">
			Upload Book
		</button>

		if values.SuccessMessage != "" {
			<div class="mt-4 p-4 bg-green-100 border border-green-300 rounded-md">
				<p class="text-center text-green-700">{ values.SuccessMessage }</p>
			</div>
		}
		
		<a href="/books" class="text-blue-600 hover:underline">← Back to Books</a>
	</form>
}

// BookView renders the detail view for a single book
templ BookView(book Book) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<div class="w-full justify-center gap-10">
			<div class="mt-10 lg:mt-20">
				<div class="max-w-4xl mx-auto border rounded-md shadow-sm py-12 px-8 flex flex-col gap-8">
					<h2 class="text-center text-2xl font-medium">{ book.Name }</h2>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div>
							<div class="aspect-[3/4] bg-gray-100 rounded-md flex items-center justify-center">
								<!-- PDF preview placeholder - in a real app you might generate a thumbnail -->
								<div class="text-center p-8">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-24 h-24 mx-auto text-gray-400">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
									</svg>
									<p class="mt-4 text-gray-600">PDF Document</p>
									<p class="text-sm text-gray-500">{ filepath.Base(book.Location) }</p>
								</div>
							</div>
						</div>
						
						<div class="flex flex-col gap-6">
							<div>
								<h3 class="text-lg font-medium">Book Details</h3>
								<div class="mt-4 space-y-2">
									<div class="flex justify-between border-b pb-2">
										<span class="text-gray-600">Title:</span>
										<span class="font-medium">{ book.Name }</span>
									</div>
									<div class="flex justify-between border-b pb-2">
										<span class="text-gray-600">Pages:</span>
										<span class="font-medium">
											if book.Pages > 0 {
												{ strconv.Itoa(book.Pages) }
											} else {
												<span class="text-gray-400">Not specified</span>
											}
										</span>
									</div>
									<div class="flex justify-between border-b pb-2">
										<span class="text-gray-600">Uploaded:</span>
										<span class="font-medium">{ book.CreatedAt.Format("Jan 02, 2006 15:04") }</span>
									</div>
								</div>
							</div>
							
							<div class="flex flex-col gap-3 mt-6">
								<a href={ templ.SafeURL("/books/" + strconv.FormatUint(uint64(book.ID), 10) + "/read") } { components.ButtonAttrs()... } class="flex items-center justify-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
									</svg>
									Read Book
								</a>
								<button hx-delete={ "/books/" + strconv.FormatUint(uint64(book.ID), 10) } 
									hx-confirm="Are you sure you want to delete this book?" 
									hx-target="body"
									hx-push-url="/books"
									class="mt-2 text-red-600 hover:text-red-800">
									Delete Book
								</button>
								<a href="/books" class="text-blue-600 hover:underline text-center mt-4">← Back to Books</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}