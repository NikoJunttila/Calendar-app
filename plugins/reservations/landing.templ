package reservations

import (
	"context"
	"gothstack/app/views/components"
	"gothstack/app/views/layouts"
)

type LandingPageData struct {
	Features []struct {
		Title       string
		Description string
		Icon        string
	}
}

templ LandingPage(ctx context.Context, data LandingPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main>

<!-- Hero Section -->
<section class="relative isolate overflow-hidden bg-gradient-to-br py-16 from-blue-50 to-white">
	<!-- Decorative Background SVG -->
	<div class="absolute inset-x-0 top-[-10rem] -z-10 transform-gpu overflow-hidden blur-3xl">
		<svg class="relative left-[calc(50%-11rem)] h-[21.1875rem] max-w-none -translate-x-1/2 sm:left-[calc(50%-30rem)] sm:h-[42.375rem]" viewBox="0 0 1155 678" fill="none">
			<path fill="url(#gradient1)" fill-opacity=".3" d="M317 0L0 317l317 317h521V0H317Z" />
			<defs>
				<linearGradient id="gradient1" x1="0" y1="0" x2="1155" y2="678" gradientUnits="userSpaceOnUse">
					<stop stop-color="#60a5fa" />
					<stop offset="1" stop-color="#a78bfa" />
				</linearGradient>
			</defs>
		</svg>
	</div>

	<div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
		<div class="max-w-2xl mx-auto">
			<h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
				Your Time, Organized Effortlessly
			</h1>
			<p class="mt-6 text-lg leading-8 text-gray-700">
				Simplify your scheduling. Define availability, accept bookings online, and reduce no-shows — all without the back-and-forth.
			</p>
			<div class="mt-10 flex items-center gap-x-6">
				<a href="/auth/register" class="rounded-md bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
					Get Started
				</a>
				<a href="#features" class="text-sm font-semibold leading-6 text-blue-700 hover:text-blue-900">
					Learn more <span aria-hidden="true">→</span>
				</a>
			</div>
		</div>

	</div>
</section>


			<!-- Feature Section -->
			<div id="features" class="mx-auto max-w-7xl px-6 mt-16 lg:px-8">
				<div class="mx-auto max-w-2xl lg:text-center">
					<h2 class="text-base font-semibold leading-7 text-blue-600">Faster Scheduling</h2>
					<p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
						Everything you need to manage appointments
					</p>
					<p class="mt-6 text-lg leading-8 text-gray-600">
						Create your availability slots, manage bookings, and let your clients schedule appointments online. Save time and reduce no-shows.
					</p>
				</div>
				<div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
					<dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
						for _, feature := range data.Features {
							<div class="flex flex-col">
								<dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-gray-900">
									<svg class="h-5 w-5 flex-none text-blue-600" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d={ feature.Icon } clip-rule="evenodd"></path>
									</svg>
									{ feature.Title }
								</dt>
								<dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
									<p class="flex-auto">{ feature.Description }</p>
								</dd>
							</div>
						}
					</dl>
				</div>
			</div>
			<!-- CTA Section -->
			<div class="relative isolate mt-32 px-6 py-32 sm:mt-56 sm:py-40 lg:px-8">
				<div class="absolute inset-x-0 top-1/2 -z-10 -translate-y-1/2 transform-gpu overflow-hidden opacity-30 blur-3xl" aria-hidden="true">
					<div class="ml-[max(50%,38rem)] aspect-[1313/771] w-[82.125rem] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
				</div>
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
						Ready to streamline your scheduling?
					</h2>
					<p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-gray-600">
						Join thousands of professionals who are already using our platform to manage their appointments.
					</p>
					<div class="mt-10 flex items-center justify-center gap-x-6">
						<a href="/auth/register" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
							Get started
						</a>
						<a href="/auth/login" class="text-sm font-semibold leading-6 text-gray-900">
							Sign in <span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</main>
	}
}
