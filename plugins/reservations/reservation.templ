package reservations

import (
	"gothstack/app/views/components"
	"gothstack/app/views/layouts"
	"fmt"
)

templ ReservationsIndex(data ReservationsPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		
		<main class="container mx-auto px-4 py-8 max-w-4xl">
			<div class="flex items-center gap-4 mb-6">
				<a href="/dashboard" class="text-gray-600 hover:text-gray-900">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
					</svg>
				</a>
				<h1 class="text-3xl font-bold">All reservations</h1>
			</div>
			
			if data.ErrorMessage != "" {
				<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
					<p>{ data.ErrorMessage }</p>
				</div>
			}
			
			if len(data.Bookings) == 0 {
				<div class="text-center py-8">
					<p class="text-gray-500">No reservations found</p>
				</div>    
			} else {
				<div class="bg-white shadow rounded-lg overflow-hidden">
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking ID</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duration</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							for _, booking := range data.Bookings {
								<tr>
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{ booking.BookingRef }</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										<div>{ booking.ClientName }</div>
										<div class="text-xs text-gray-400">{ booking.ClientEmail }</div>
										if booking.ClientPhone != "" {
											<div class="text-xs text-gray-400">{ booking.ClientPhone }</div>
										}
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{ ConvertDateFormat(booking.TimeSlot.Date) }
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
										{ formatDuration(booking.TimeSlot.Duration) }
									</td>
									<td class="px-6 py-4 whitespace-nowrap">
										<span class={statusBadgeClass(booking.Status)}>
											{ booking.Status }
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
										<form method="DELETE" action={templ.SafeURL("/reservations/" + fmt.Sprint(booking.ID) + "/delete")} onsubmit="return confirm('Are you sure you want to delete this booking?');">
											<button type="submit" class="text-red-600 hover:text-red-900">
												Delete
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</main>
	}
}


func pluralS(count int) string {
	if count == 1 {
		return ""
	}
	return "s"
}

// Helper function to determine status badge color
func statusBadgeClass(status string) string {
	switch BookingStatus(status) {
	case StatusBookingConfirmed:
		return "bg-blue-100 text-blue-800"
	case StatusBookingCancelled:
		return "bg-gray-100 text-gray-800"
	case StatusBookingCompleted:
		return "bg-green-100 text-green-800"
	default:
		return "bg-gray-100 text-gray-800"
	}
}

// Helper function to determine card background color
func bookingStatusColor(status string) string {
	switch BookingStatus(status) {
	case StatusBookingConfirmed:
		return "bg-blue-50 border-blue-200"
	case StatusBookingCancelled:
		return "bg-gray-100 border-gray-300 opacity-75"
	case StatusBookingCompleted:
		return "bg-green-50 border-green-200"
	default:
		return "bg-white border-gray-200"
	}
}

templ SettingsForm(data SettingsFormData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main class="container mx-auto px-4 py-8 max-w-2xl">
			<div class="flex items-center gap-4 mb-6">
				<a href="/dashboard" class="text-gray-600 hover:text-gray-900">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
					</svg>
				</a>
				<h1 class="text-3xl font-bold">Reservation Settings</h1>
			</div>
			// Display Success/Error Messages
			if data.SuccessMessage != "" {
				<div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
					{ data.SuccessMessage }
				</div>
			}
			if data.ErrorMessage != "" {
				<div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
					{ data.ErrorMessage }
				</div>
			}
			<form method="POST" action="/reservations/settings" class="space-y-6 bg-white p-6 rounded-lg shadow">
				// Timezone (Consider using a select with common timezones)
				<div class="form-control">
					<label for="timezone" class="label">
						<span class="label-text">Timezone</span>
					</label>
					<input type="text" id="timezone" name="timezone" value={ data.Setting.Timezone } placeholder="e.g., UTC, America/New_York" class="input input-bordered w-full"/>
					// Example Select (needs populating timezone list):
					// <select id="timezone" name="timezone" class="select select-bordered w-full">
					//   <option value="UTC" selected={data.Setting.Timezone == "UTC"}>UTC</option>
					//   <option value="America/New_York" selected={data.Setting.Timezone == "America/New_York"}>America/New_York</option>
					// </select>
				</div>
				// Notifications
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-2">
							<input type="checkbox" id="notification_email" name="notification_email" class="checkbox checkbox-primary" checked?={ data.Setting.NotificationEmail }/>
							<span class="label-text">Email Notifications</span>
						</label>
					</div>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-2">
							<input type="checkbox" id="notification_sms" name="notification_sms" class="checkbox checkbox-primary" checked?={ data.Setting.NotificationSMS }/>
							<span class="label-text">SMS Notifications (if enabled)</span>
						</label>
					</div>
				</div>
				// Calendar View Preference
				<div class="form-control">
					<label for="calendar_view" class="label">
						<span class="label-text">Default Calendar View</span>
					</label>
					<select id="calendar_view" name="calendar_view" class="select select-bordered w-full">
						<option value="week" selected?={ data.Setting.CalendarView == "week" }>Week</option>
						<option value="month" selected?={ data.Setting.CalendarView == "month" }>Month</option>
						<option value="day" selected?={ data.Setting.CalendarView == "day" }>Day</option>
					</select>
				</div>
				// Scheduling Notice/Advance
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="form-control">
						<label for="min_scheduling_notice" class="label">
							<span class="label-text">Minimum Scheduling Notice (hours)</span>
						</label>
						<input type="number" id="min_scheduling_notice" name="min_scheduling_notice" value={ fmt.Sprintf("%d", data.Setting.MinSchedulingNotice) } min="0" class="input input-bordered w-full"/>
					</div>
					<div class="form-control">
						<label for="max_scheduling_advance" class="label">
							<span class="label-text">Maximum Scheduling Advance (days)</span>
						</label>
						<input type="number" id="max_scheduling_advance" name="max_scheduling_advance" value={ fmt.Sprintf("%d", data.Setting.MaxSchedulingAdvance) } min="1" class="input input-bordered w-full"/>
					</div>
				</div>
				// Submit Button
				<div class="pt-4">
					<button type="submit" class="btn btn-primary w-full md:w-auto">Save Settings</button>
				</div>
			</form>
		</main>
	}
}
