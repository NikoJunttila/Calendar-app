package reservations

import (
	"fmt"
	"gothstack/app/views/components"
	"gothstack/app/views/layouts"
)

// SpecialDatePageData holds data for the special dates settings page
type SpecialDatePageData struct {
	UserID       uint
	UserName     string
	SpecialDates []SpecialDate
	Error        string
	Success      string
}

// SpecialDateSettings displays the special dates settings form
templ SpecialDateSettings(data SpecialDatePageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-6">Special Dates Settings</h1>
			
			if data.Error != "" {
				<div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
					Error: { data.Error }
				</div>
			}
			if data.Success != "" {
				<div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
					{ data.Success }
				</div>
			}

			<!-- Add new special date form -->
			<div class="mb-8 bg-white p-6 rounded-lg shadow-md">
				<h2 class="text-xl font-semibold mb-4">Add New Special Date</h2>
				<form method="POST" action={ templ.URL("/reservations/special-dates") } class="space-y-4">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-gray-700">Date</label>
							<input type="date" 
								name="date"
								required
								class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700">Description</label>
							<input type="text" 
								name="description"
								required
								placeholder="e.g., Christmas Day, Company Holiday"
								class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
						</div>
					</div>
					<div class="flex items-center">
						<input type="checkbox" 
							name="is_working_day"
							class="form-checkbox h-5 w-5 text-blue-600">
						<label class="ml-2 text-sm font-medium text-gray-700">This is a working day</label>
					</div>
					<div class="flex justify-end">
						<button type="submit" class="btn btn-primary">
							Add Special Date
						</button>
					</div>
				</form>
			</div>

			<!-- List of existing special dates -->
			<div class="bg-white p-6 rounded-lg shadow-md">
				<h2 class="text-xl font-semibold mb-4">Existing Special Dates</h2>
				if len(data.SpecialDates) == 0 {
					<p class="text-gray-500">No special dates have been added yet.</p>
				} else {
					<div class="space-y-4">
						for _, date := range data.SpecialDates {
							<div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
								<div>
									<h3 class="font-medium">{ date.Description }</h3>
									<p class="text-sm text-gray-600">{ date.Date }</p>
									if date.IsWorkingDay {
										<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
											Working Day
										</span>
									}
								</div>
								<form method="POST" action={ templ.URL(fmt.Sprintf("/reservations/special-dates/%d/delete", date.ID)) } class="inline">
									<button type="submit" 
										class="text-red-600 hover:text-red-800"
										onclick="return confirm('Are you sure you want to delete this special date?')">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
										</svg>
									</button>
								</form>
							</div>
						}
					</div>
				}
			</div>
		</main>
	}
}
