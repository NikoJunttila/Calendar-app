package reservations
import (
	"fmt"
	"gothstack/app/views/components"
	"gothstack/app/views/layouts"
)
// BusinessHoursPageData holds data for the business hours settings page
type BusinessHoursPageData struct {
	UserID       uint
	UserName     string
	BusinessHours []BusinessHour
	Error        string
	Success      string
}
// BusinessHoursSettings displays the business hours settings form
templ BusinessHoursSettings(data BusinessHoursPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-6">Business Hours Settings</h1>
			if data.Error != "" {
				<div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
					Error: { data.Error }
				</div>
			}
			if data.Success != "" {
				<div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
					{ data.Success }
				</div>
			}
			<form method="POST" action={ templ.URL("/reservations/business-hours") } class="space-y-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					for i, day := range []string{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"} {
						<div class="bg-white p-4 rounded-lg shadow">
							<div class="flex items-center mb-4">
								if getBusinessHourForDay(data.BusinessHours, i).IsWorkingDay {
									<input type="checkbox" 
										name={ fmt.Sprintf("is_working_%d", i)}
										class="form-checkbox h-5 w-5 text-blue-600"
										checked>
								} else {
									<input type="checkbox" 
										name={ fmt.Sprintf("is_working_%d", i)}
										class="form-checkbox h-5 w-5 text-blue-600">
								}
								<label class="ml-2 text-lg font-semibold">{ day }</label>
							</div>
							<div class="grid grid-cols-2 gap-4">
								<div>
									<label class="block text-sm font-medium text-gray-700">Start Time</label>
									<input type="time" 
										name={ fmt.Sprintf("start_time_%d", i) }
										value={ getBusinessHourForDay(data.BusinessHours, i).StartTime }
										class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
								</div>
								<div>
									<label class="block text-sm font-medium text-gray-700">End Time</label>
									<input type="time" 
										name={ fmt.Sprintf("end_time_%d", i) }
										value={ getBusinessHourForDay(data.BusinessHours, i).EndTime }
										class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
								</div>
							</div>
						</div>
					}
				</div>
				<div class="flex justify-end">
					<button type="submit" class="btn btn-primary">
						Save Business Hours
					</button>
				</div>
			</form>
		</main>
	}
}
// Helper function to get business hour for a specific day
func getBusinessHourForDay(hours []BusinessHour, day int) BusinessHour {
	for _, hour := range hours {
		if hour.DayOfWeek == day {
			return hour
		}
	}
	// Return default working hours if not found
	return BusinessHour{
		DayOfWeek:    day,
		StartTime:    "09:00",
		EndTime:      "17:00",
		IsWorkingDay: true,
	}
}