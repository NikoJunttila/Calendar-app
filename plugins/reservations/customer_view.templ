package reservations

import (
	"fmt"
	"database/sql" // Needed for sql.NullFloat64
	"gothstack/app/views/components" // Import components
	"gothstack/app/views/layouts"    // Import layouts
)

// --- Helper Functions ---

// formatPrice formats the price for display.
func formatPrice(price sql.NullFloat64) string {
	if price.Valid {
		// Adjust currency symbol/format as needed
		return fmt.Sprintf("$%.2f", price.Float64)
	}
	// Display text for free services
	return "Free"
}

// formatDuration formats the duration in minutes into a readable string.
func formatDuration(minutes int) string {
	if minutes < 60 {
		return fmt.Sprintf("%d min", minutes)
	}
	hours := minutes / 60
	remainingMinutes := minutes % 60
	if remainingMinutes == 0 {
		if hours == 1 {
			return "1 hour"
		}
		return fmt.Sprintf("%d hours", hours)
	}
	return fmt.Sprintf("%d hr %d min", hours, remainingMinutes)
}

// --- Components ---

// CustomerServiceList displays the list of services available for booking.
// It should ideally be wrapped in a main layout component.
templ CustomerServiceList(data CustomerServiceListPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-6">Select a Service from { data.UserName }</h1>

			if data.Error != "" {
				<div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
					Error: { data.Error }
				</div>
			} else if len(data.Services) == 0 {
				<p class="text-gray-600">No services are currently available for booking.</p>
			} else {
				<ul class="space-y-4">
					for _, service := range data.Services {
						<li class="bg-white border border-gray-200 p-4 rounded-lg shadow hover:shadow-md transition-shadow duration-200">
							<a href={ templ.URL(fmt.Sprintf("/book/%d/service/%d", data.UserID, service.ID)) } class="text-blue-600 hover:underline">
								<h2 class="text-xl font-semibold">{ service.Name }</h2>
							</a>
							if service.Description.Valid {
								<p class="text-gray-700 mt-1">{ service.Description.String }</p>
							}
							<div class="mt-2 text-sm text-gray-600 flex flex-wrap gap-x-4 gap-y-1">
								<span>Duration: { formatDuration(service.Duration) }</span>
								<span>Price: { formatPrice(service.Price) }</span>
								if service.Location.Valid {
									<span>Location: { service.Location.String }</span>
								}
							</div>
						</li>
					}
				</ul>
			}
		</main>
	}
}

// CustomerTimeSlotSelection displays available time slots for a specific service.
// It should also ideally be wrapped in a main layout component.
templ CustomerTimeSlotSelection(data CustomerTimeSlotPageData) {
	@layouts.BaseLayout() {
		@components.Navigation()
		<main class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-6">Select an Available Time</h1>

			<div class="mb-6 p-4 border border-gray-200 rounded-lg bg-gray-50 shadow-sm">
				<h2 class="text-xl font-semibold">Service: { data.Service.Name }</h2>
				<div class="mt-2 text-sm text-gray-700 flex flex-wrap gap-x-4 gap-y-1">
					<span>Duration: { formatDuration(data.Service.Duration) }</span>
					<span>Price: { formatPrice(data.Service.Price) }</span>
					if data.Service.Description.Valid {
						<span>Details: { data.Service.Description.String }</span>
					}
					if data.Service.Location.Valid {
						<span>Location: { data.Service.Location.String }</span>
					}
				</div>
			</div>

			if data.Error != "" {
				<div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-200">
					Error: { data.Error }
				</div>
			} else if len(data.Slots) == 0 {
				<p class="text-gray-600">No available time slots found for this service in the near future.</p>
			} else {
			    <h3 class="text-2xl font-semibold mb-4">Available Slots:</h3>
    if len(data.Slots) > 0 {
        <h4 class="font-semibold text-lg mt-5 mb-2">{ data.Slots[0].Date }</h4>
		<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-2">
		 for i, slot := range data.Slots {
                if i > 0 && slot.Date != data.Slots[i-1].Date {
                    <h4 class="font-semibold text-lg mt-5 mb-2">{ slot.Date }</h4>
                }
                <a href={ templ.URL(fmt.Sprintf("/book/%d/service/%d/confirm?slotID=%d", data.UserID, data.Service.ID, slot.ID)) } class="btn btn-outline btn-primary btn-sm">
                    { slot.Time }
                </a>
            }
		</div>
    }




			}

			<p class="mt-8">
				<a href={ templ.URL(fmt.Sprintf("/book/%d", data.UserID)) } class="text-blue-600 hover:underline">&laquo; Back to Services</a>
			</p>
		</main>
	}
}